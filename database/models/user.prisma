model User {
    id           String   @id @default(cuid())
    firstName    String
    lastName     String
    email        String   @unique
    password     String
    bio          String   @default("")
    systemPrompt String   @default("You are Aria, a helpful AI assistant. Respond naturally and concisely.")
    theme        String   @default("dark")
    plan         String   @default("free")
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    conversations     Conversation[]
    userSubscriptions UserSubscription[]
    teamMembers       TeamMember[]
    teamOwnership     TeamMember[]       @relation("TeamOwner")
    webhooks          Webhook[]
}
